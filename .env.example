# TiDB Cloud
DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=keuangan
# Opsional: path file CA. Kosongkan untuk memakai CA bawaan Node.
DB_CA_PATH=

# Admin panel — dipakai untuk membuat akun pertama di tabel `admins`
# (dan oleh `npm run admin:set`). Login sendiri dicek ke database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Minimal 32 karakter acak
SESSION_SECRET=
